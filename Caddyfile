:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=15552000"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), gamepad=(self), screen-wake-lock=(self)"
	}

	handle /healthz {
		respond "ok" 200
	}

	# A missing immutable asset must fail explicitly, never receive the SPA shell.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}
		file_server
	}

	handle {
		# El Service Worker, el manifest y el documento no se cachean para que
		# las actualizaciones de la PWA se detecten; los assets con hash sí.
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache {
			Cache-Control "no-store, no-cache, must-revalidate"
			CDN-Cache-Control "no-store"
		}
		try_files {path} /index.html
		file_server
	}
}
