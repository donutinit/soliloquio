:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		# El Service Worker, el manifest y el documento no se cachean para que
		# las actualizaciones de la PWA se detecten; los assets con hash sí.
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache, must-revalidate"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
